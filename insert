WHERE p.product_code = 'MISC_LO'
  AND s.product_id = p.id
  AND r.rule_code IN ('VEHICLE_AGE','STATE_LOOKUP','MAKE_MODEL','POLICY_TYPE');

-- ── Policy Type Config — DEFAULT ──────────────────────────────────────────
-- Applies to all products (product-level, subtype NULL)
INSERT INTO policy_type_config
    (client_id, product_id, subtype_id, policy_type, rsd_rule_type, max_rsd_gap_days, is_allowed)
SELECT 'DEFAULT', p.id, NULL,
       pc.policy_type, pc.rsd_rule_type, pc.gap, TRUE
FROM motor_insurance_product p
CROSS JOIN (VALUES
    ('CONTINUOUS',              'EXPIRY_PLUS_1',           0),
    ('BREAKIN_NO_INSPECTION',   'T_PLUS_3_NO_INSPECTION',  3),
    ('BREAKIN_WITH_INSPECTION', 'T_WITH_INSPECTION',        0)
) AS pc(policy_type, rsd_rule_type, gap);

