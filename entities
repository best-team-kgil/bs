// RuleDefinition.java
package com.insurance.brms.entity;

import com.insurance.brms.enums.ComparisonOperator;
import com.insurance.brms.enums.OperatorType;
import jakarta.persistence.*;
import lombok.*;

@Entity
@Table(name = "rule_definition")
@Getter @Setter @NoArgsConstructor @AllArgsConstructor @Builder
public class RuleDefinition {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    /** Unique identifier used by engine to load and evaluate rules. e.g. VEHICLE_AGE */
    @Column(name = "rule_code", nullable = false, unique = true, length = 60)
    private String ruleCode;

    @Column(name = "rule_name", nullable = false, length = 150)
    private String ruleName;

    /** Evaluation strategy — which evaluator method to invoke in the engine. */
    @Enumerated(EnumType.STRING)
    @Column(name = "operator_type", nullable = false, length = 20)
    private OperatorType operatorType;

    /**
     * Only populated for THRESHOLD rules.
     * Tells engine which direction the single-sided numeric check goes.
     * NULL for RANGE, IN_LIST, STATE_LOOKUP, EXTERNAL_API, POLICY_TYPE.
     */
    @Enumerated(EnumType.STRING)
    @Column(name = "comparison_operator", length = 25)
    private ComparisonOperator comparisonOperator;

    @Column(name = "data_type", nullable = false, length = 20)
    private String dataType;

    /**
     * Exact API response message when this rule fails.
     * Business team changes the message via DB — zero code change needed.
     */
    @Column(name = "error_message", nullable = false, length = 500)
    private String errorMessage;

    @Column(name = "is_active", nullable = false)
    private Boolean isActive;
}

// ClientProductRuleConfig.java
package com.insurance.brms.entity;

import jakarta.persistence.*;
import lombok.*;
import java.time.LocalDate;

@Entity
@Table(name = "client_product_rule_config")
@Getter @Setter @NoArgsConstructor @AllArgsConstructor @Builder
public class ClientProductRuleConfig {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    /** References client_master.client_id — 'DEFAULT' = base config for all clients. */
    @Column(name = "client_id", nullable = false, length = 50)
    private String clientId;

    @ManyToOne(fetch = FetchType.LAZY)
    @JoinColumn(name = "product_id", nullable = false)
    private MotorInsuranceProduct product;

    /**
     * NULL means this config applies to all subtypes of the product.
     * When set, it overrides the product-level (NULL subtype) config for that subtype.
     */
    @ManyToOne(fetch = FetchType.LAZY)
    @JoinColumn(name = "subtype_id")
    private ProductSubtype subtype;

    /** Fetched EAGER so rule details are available without extra query in engine. */
    @ManyToOne(fetch = FetchType.EAGER)
    @JoinColumn(name = "rule_id", nullable = false)
    private RuleDefinition rule;

    /** For THRESHOLD rules — the single boundary value. e.g. '15' for age < 15. */
    @Column(name = "threshold_value", length = 50)
    private String thresholdValue;

    /** For RANGE rules — lower bound. Per business doc: exclusive (exceeding). */
    @Column(name = "min_value", length = 50)
    private String minValue;

    /** For RANGE rules — upper bound. Per business doc: inclusive (not exceeding). */
    @Column(name = "max_value", length = 50)
    private String maxValue;

    /** For IN_LIST rules — comma-separated values. e.g. 'SCOOTER,SCOOTERETTE'. */
    @Column(name = "allowed_values", columnDefinition = "TEXT")
    private String allowedValues;

    /** If true, evaluation stops immediately on failure and error is returned. */
    @Column(name = "is_mandatory", nullable = false)
    private Boolean isMandatory;

    @Column(name = "is_active", nullable = false)
    private Boolean isActive;

    /**
     * Business team can schedule rule changes by setting future effective_from.
     * Engine filters: effectiveFrom <= today AND (effectiveTo IS NULL OR effectiveTo >= today).
     */
    @Column(name = "effective_from", nullable = false)
    private LocalDate effectiveFrom;

    @Column(name = "effective_to")
    private LocalDate effectiveTo;
}

