// ClientProductRuleConfigRepository.java
package com.insurance.brms.repository;

import com.insurance.brms.entity.ClientProductRuleConfig;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;
import java.time.LocalDate;
import java.util.List;

@Repository
public interface ClientProductRuleConfigRepository
        extends JpaRepository<ClientProductRuleConfig, Long> {

    /**
     * Loads all effective rules for a client + product + subtype combination.
     *
     * Priority ordering (highest first, engine de-duplicates by rule_code):
     *   1. client-specific + subtype-specific
     *   2. client-specific + product-level (subtype NULL)
     *   3. DEFAULT         + subtype-specific
     *   4. DEFAULT         + product-level
     *
     * The CASE expressions in ORDER BY encode the priority without any code logic.
     * Engine iterates the list and skips any rule_code already seen (Set<String>).
     */
    @Query("""
            SELECT c FROM ClientProductRuleConfig c
            JOIN FETCH c.rule r
            WHERE c.product.id      = :productId
              AND (c.subtype IS NULL OR c.subtype.id = :subtypeId)
              AND c.clientId        IN (:clientId, 'DEFAULT')
              AND c.isActive        = TRUE
              AND r.isActive        = TRUE
              AND c.effectiveFrom   <= :today
              AND (c.effectiveTo IS NULL OR c.effectiveTo >= :today)
            ORDER BY
              CASE WHEN c.clientId  = :clientId THEN 0 ELSE 1 END ASC,
              CASE WHEN c.subtype  IS NOT NULL   THEN 0 ELSE 1 END ASC
            """)
    List<ClientProductRuleConfig> findEffectiveRules(
            @Param("clientId")  String clientId,
            @Param("productId") Long productId,
            @Param("subtypeId") Long subtypeId,
            @Param("today")     LocalDate today);

    /**
     * Overload for products with no subtype (PC_LO, TW_LO, GCV_LO).
     * Returns only product-level rules (subtype IS NULL).
     */
    @Query("""
            SELECT c FROM ClientProductRuleConfig c
            JOIN FETCH c.rule r
            WHERE c.product.id    = :productId
              AND c.subtype       IS NULL
              AND c.clientId      IN (:clientId, 'DEFAULT')
              AND c.isActive      = TRUE
              AND r.isActive      = TRUE
              AND c.effectiveFrom <= :today
              AND (c.effectiveTo IS NULL OR c.effectiveTo >= :today)
            ORDER BY
              CASE WHEN c.clientId = :clientId THEN 0 ELSE 1 END ASC
            """)
    List<ClientProductRuleConfig> findEffectiveRulesNoSubtype(
            @Param("clientId")  String clientId,
            @Param("productId") Long productId,
            @Param("today")     LocalDate today);
}

