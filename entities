package com.insurance.brms.repository;

import com.insurance.brms.entity.ProductStateBusinessStatus;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;
import java.util.List;

@Repository
public interface ProductStateBusinessStatusRepository
        extends JpaRepository<ProductStateBusinessStatus, Long> {

    /**
     * Resolves business status for client + product + subtype + state.
     * Same 4-level priority as rule config. First result = most specific.
     */
    @Query("""
            SELECT s FROM ProductStateBusinessStatus s
            WHERE s.product.id      = :productId
              AND (s.subtype IS NULL OR s.subtype.id = :subtypeId)
              AND s.state.stateCode = :stateCode
              AND s.clientId        IN (:clientId, 'DEFAULT')
              AND s.isActive        = TRUE
            ORDER BY
              CASE WHEN s.clientId = :clientId THEN 0 ELSE 1 END ASC,
              CASE WHEN s.subtype IS NOT NULL   THEN 0 ELSE 1 END ASC
            """)
    List<ProductStateBusinessStatus> findBusinessStatus(
            @Param("clientId")  String clientId,
            @Param("productId") Long productId,
            @Param("subtypeId") Long subtypeId,
            @Param("stateCode") String stateCode);
}

