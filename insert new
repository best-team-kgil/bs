-- ── Client Product Rule Config — DEFAULT client ───────────────────────────

-- VEHICLE_AGE: < 15 years — applies to all products, no subtype
INSERT INTO client_product_rule_config
    (client_id, product_id, subtype_id, rule_id, threshold_value, is_mandatory, effective_from)
SELECT 'DEFAULT', p.id, NULL, r.id, '15', TRUE, CURRENT_DATE
FROM motor_insurance_product p
CROSS JOIN rule_definition r
WHERE r.rule_code = 'VEHICLE_AGE';

-- CUBIC_CAPACITY_TW: < 150cc — TW_LO only
INSERT INTO client_product_rule_config
    (client_id, product_id, subtype_id, rule_id, threshold_value, is_mandatory, effective_from)
SELECT 'DEFAULT', p.id, NULL, r.id, '150', TRUE, CURRENT_DATE
FROM motor_insurance_product p, rule_definition r
WHERE p.product_code = 'TW_LO' AND r.rule_code = 'CUBIC_CAPACITY_TW';

-- CUBIC_CAPACITY_PC: exceeding 1000 but not exceeding 1500 — PC_LO only
INSERT INTO client_product_rule_config
    (client_id, product_id, subtype_id, rule_id, min_value, max_value, is_mandatory, effective_from)
SELECT 'DEFAULT', p.id, NULL, r.id, '1000', '1500', TRUE, CURRENT_DATE
FROM motor_insurance_product p, rule_definition r
WHERE p.product_code = 'PC_LO' AND r.rule_code = 'CUBIC_CAPACITY_PC';

-- GVW: < 43 tons — GCV_LO only
INSERT INTO client_product_rule_config
    (client_id, product_id, subtype_id, rule_id, threshold_value, is_mandatory, effective_from)
SELECT 'DEFAULT', p.id, NULL, r.id, '43', TRUE, CURRENT_DATE
FROM motor_insurance_product p, rule_definition r
WHERE p.product_code = 'GCV_LO' AND r.rule_code = 'GVW';

-- SEATING_CAPACITY_MIN > 17 — STAFF_BUS and SCHOOL_BUS
INSERT INTO client_product_rule_config
    (client_id, product_id, subtype_id, rule_id, threshold_value, is_mandatory, effective_from)
SELECT 'DEFAULT', p.id, s.id, r.id, '17', TRUE, CURRENT_DATE
FROM motor_insurance_product p
JOIN product_subtype s ON s.product_id = p.id
CROSS JOIN rule_definition r
WHERE p.product_code = 'PCV_LO'
  AND s.subtype_code IN ('STAFF_BUS', 'SCHOOL_BUS')
  AND r.rule_code = 'SEATING_CAPACITY_MIN';

