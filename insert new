-- ── Policy Type Config — DEFAULT, all products ────────────────────────────
INSERT INTO policy_type_config
    (client_id, product_id, subtype_id, policy_type, rsd_rule_type, max_rsd_gap_days, is_allowed)
SELECT 'DEFAULT', p.id, NULL, pt.policy_type, pt.rsd_rule, pt.gap_days, TRUE
FROM motor_insurance_product p
CROSS JOIN (VALUES
    ('CONTINUOUS',              'EXPIRY_PLUS_1',          0),
    ('BREAKIN_NO_INSPECTION',   'T_PLUS_N_NO_INSPECTION', 3),
    ('BREAKIN_WITH_INSPECTION', 'T_WITH_INSPECTION',      0)
) AS pt(policy_type, rsd_rule, gap_days);

